{
  "name": "kettle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test",
    "worker:build": "esbuild worker/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=worker/dist/index.js --tsconfig=tsconfig.json --log-level=warning",
    "worker:dev": "tsx --env-file=.env.local worker/index.ts",
    "bench": "tsx --env-file=.env.local evals/model-bench.ts",
    "eval": "tsx --env-file=.env.local evals/golden-path.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "pdfjs-dist": "^6.3.289",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
