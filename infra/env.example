# Runtime env for Kettle on VM-A: /opt/kettle/.env (600 perms, owned by deploy user, never in git).
# Names only — real values are never committed. See infra/README.md for access details.

# --- Supabase (VM-B, reached over the VPC / via NetBird for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Vultr Serverless Inference (LLM calls) ---
VULTR_INFERENCE_BASE_URL=
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=

# --- Worker-specific (agent orchestrator loop, web/worker/dist/index.js) ---
WORKER_CONCURRENCY=
WORKER_ID=
VULTR_AGENT_MODEL=

# --- NOT included here: VULTR_API_KEY / VULTR_ADMIN_KEY ---
# Those are only ever used from the machine driving Vultr's provisioning API
# (this agent's own environment), never deployed to VM-A.

# --- NOT included here: KETTLE_OPS_PASSWORD / KETTLE_SALES_PASSWORD / KETTLE_FINANCE_PASSWORD ---
# Those live on VM-B (/root/supabase/.env, 600 perms), not VM-A — set once by
# web/supabase/create-demo-users.sql, read via SSH through the jump host for judging.
